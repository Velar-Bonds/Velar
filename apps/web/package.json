{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node init && node ../../scripts/dev.mjs",
    "dev:next": "node init && next dev",
    "prebuild": "npm run build --workspace @velar/types && npm run build --workspace @velar/ui",
    "build": "node init && next build",
    "start": "node init && next start",
    "lint": "eslint",
    "pretypecheck": "npm run build --workspace @velar/types && npm run build --workspace @velar/ui",
    "typecheck": "tsc --noEmit",
    "doctor": "npx react-doctor@latest",
    "pretest": "npm run build --workspace @velar/types && npm run build --workspace @velar/ui",
    "test": "jest --runInBand",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.5.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "@velar/types": "*",
    "@velar/ui": "*",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "ogl": "^1.0.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@velar/config": "*",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jest": "^30.0.0",
    "jest-axe": "^9.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.2.5",
    "typescript": "^5"
  }
}
